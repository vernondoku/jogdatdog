{
  "redirects": [
    {
      "source": "/gallery",
      "destination": "/our-pack/",
      "permanent": true
    },
    {
      "source": "/gallery/",
      "destination": "/our-pack/",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/pricing/",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "/pricing/",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/about-us/",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/book/",
      "permanent": true
    },
    {
      "source": "/contact-us/",
      "destination": "/book/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}